# Copy to .env and fill in. All free tiers — sign up links in comments.

# https://www.abuseipdb.com/register  (1k req/day free)
ABUSEIPDB_KEY=

# https://otx.alienvault.com/  (unlimited free)
OTX_KEY=

# https://www.virustotal.com/gui/join-us  (500/day, 4/min)
VT_KEY=

# https://account.shodan.io/register  (free with limits)
SHODAN_KEY=

# https://ipinfo.io/signup  (50k/month)
IPINFO_TOKEN=

# https://viz.greynoise.io/signup  (community free)
GREYNOISE_KEY=

# https://pulsedive.com/  (free community tier)
PULSEDIVE_KEY=

# https://platform.openai.com/  (judges note: Codex credits via hackathon form)
OPENAI_API_KEY=

# https://console.anthropic.com/  (recommended for explainability layer + chatbot)
ANTHROPIC_API_KEY=

# https://auth.abuse.ch/  (free; required for ThreatFox / URLhaus live API)
ABUSECH_KEY=
